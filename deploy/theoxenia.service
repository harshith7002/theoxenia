[Unit]
Description=Theoxenia bounded real archive processing
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=theoxenia
WorkingDirectory=/opt/theoxenia
EnvironmentFile=/etc/theoxenia/worker.env
Environment=MPLBACKEND=Agg
Environment=OMP_NUM_THREADS=2
Environment=UV_CACHE_DIR=/var/lib/theoxenia/uv-cache
Environment=UV_PYTHON_INSTALL_DIR=/var/lib/theoxenia/python
Environment=MPLCONFIGDIR=/var/lib/theoxenia/matplotlib
ExecStart=/bin/bash /opt/theoxenia/deploy/run.sh
TimeoutStartSec=35min
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/theoxenia /var/lib/theoxenia
UMask=0077
