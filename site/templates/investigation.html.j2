{% extends "lab-base.html.j2" %}
{% block title %}{{ story.label }}{% endblock %}
{% block scripts %}<script src="../investigations.js" defer></script>{% endblock %}
{% block content %}
<header class="lab-header story-header"><a class="back-link" href="../investigations.html">← All investigations</a><p class="eyebrow">Investigation {{ story.number }} / {{ story.kind }}</p><h1>{{ story.title }}</h1><p class="lead">{{ story.question }}</p><div class="story-meta"><span>{{ manifest.experiment_id }}</span><span>Recorded {{ manifest.finished_at.strftime('%d %b %Y') }}</span><span>{{ 'Synthetic control' if story.slug == 'recovery' else 'Public archive observation' }}</span></div></header>
<nav class="chapter-nav" aria-label="Investigation chapters">{% for title, text in story.steps %}<a href="#step-{{ loop.index }}"><span>0{{ loop.index }}</span>{{ title }}</a>{% endfor %}</nav>
<div class="story-layout">
  <div class="story-steps">
  {% for title, text in story.steps %}
    <section class="story-step" id="step-{{ loop.index }}"><span class="step-number">0{{ loop.index }}</span><div><h2>{{ title }}</h2><p>{{ text }}</p></div></section>
  {% endfor %}
  </div>
  <aside class="story-evidence" aria-label="Investigation evidence">
    {% if story.slug == 'voyager' %}
    <p class="eyebrow">Observed / Voyager 1</p><a href="../{{ payload.image_url }}"><img class="story-waterfall" src="../{{ payload.image_url }}" alt="Original Voyager waterfall, received power across frequency and time"></a><p class="figure-note">Original recorded plot · Open image for full resolution.</p>
    <dl class="measurement-list"><div><dt>Carrier</dt><dd>{{ '%.6f'|format(payload.freq_mhz) }} <small>MHz</small></dd></div><div><dt>Drift</dt><dd>{{ '%+.6f'|format(payload.drift_hz_s) }} <small>Hz/s</small></dd></div><div><dt>Signal-to-noise ratio</dt><dd>{{ '%.1f'|format(payload.snr) }}</dd></div></dl>
    {% elif story.slug == 'archive' %}
    <p class="eyebrow">Observed / HIP544</p><div class="large-reading">273<span>classified rows · 1 MHz window</span></div>
    <div class="outcome-track" aria-label="149 rows in OFF scans, 124 single-pointing rows"><span style="width:54.58%">149</span><span style="width:45.42%">124</span></div><div class="plot-key"><span><i class="key-off"></i>In OFF scans</span><span><i class="key-single"></i>Single pointing</span></div>
    <div class="cadence-mini" aria-label="Scan order A B A C A D">{% for role in ['A','B','A','C','A','D'] %}<span class="{% if role == 'A' %}on{% endif %}">{{ role }}<small>{{ 'ON' if role == 'A' else 'OFF' }}</small></span>{% endfor %}</div><p class="figure-note">Scan order illustration. Individual membership is not inferred from this diagram.</p>
    <p class="warning-copy">Open issue: empty later ON detector tables. Zero survivors is a recorded outcome, not a survey-wide conclusion.</p>
    {% if explorer_available %}<a class="button-link button-primary" href="../explorer.html">Explore all 273 rows ↗</a>{% endif %}
    {% else %}
    <p class="eyebrow">Synthetic / Injection recovery</p><p>Select a measured cell. The grid shows recovered trials out of {{ payload.trials_per_cell }}.</p>
    <div class="recovery-scroll"><table class="recovery-interactive"><caption>Injected SNR × drift in Hz/s</caption><thead><tr><th scope="col">SNR ↓</th>{% for drift in payload.drift_grid %}<th scope="col">{{ '%g'|format(drift) }}</th>{% endfor %}</tr></thead><tbody>
    {% for snr in payload.snr_grid %}{% set rowindex = loop.index0 %}<tr><th scope="row">{{ '%g'|format(snr) }}</th>{% for drift in payload.drift_grid %}{% set fraction = payload.recovered_fraction[rowindex][loop.index0] %}<td><button type="button" class="recovery-cell" style="--recovery:{{ fraction }};--cell-ink:{{ '#07121d' if fraction >= 0.4 else '#eaf0fa' }}" data-snr="{{ snr }}" data-drift="{{ drift }}" data-count="{{ (fraction * payload.trials_per_cell)|round|int }}" data-trials="{{ payload.trials_per_cell }}" aria-label="SNR {{ snr }}, drift {{ drift }} Hz per second: {{ (fraction * payload.trials_per_cell)|round|int }} of {{ payload.trials_per_cell }} recovered">{{ (fraction * payload.trials_per_cell)|round|int }}</button></td>{% endfor %}</tr>{% endfor %}
    </tbody></table></div><p id="recovery-selection" class="selection-readout" aria-live="polite">Select a cell to inspect its measured recovery.</p><p class="figure-note">On small screens, scroll the grid sideways to see every drift rate.</p><p class="figure-note">Five trials per cell. This is detector regression evidence, not telescope completeness. All values remain readable without JavaScript.</p>
    {% endif %}
    <a class="text-link" href="../dossiers/{{ manifest.run_id }}.html">Read the evidence dossier →</a>
  </aside>
</div>
<section class="conclusion-panel"><p class="eyebrow">What this establishes</p><h2>{{ story.conclusion }}</h2><a class="button-link" href="../dossiers/{{ manifest.run_id }}.html">Sources, checks &amp; reproduction →</a></section>
{% endblock %}
