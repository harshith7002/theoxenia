<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="robots" content="noindex, nofollow">
  <meta name="description" content="Theoxenia Mission Control — an evidence-first radio data search status page.">
  <title>Theoxenia · Mission control</title>
  <link rel="stylesheet" href="styles.css">
</head>
<body>
  <a class="skip-link" href="#main">Skip to content</a>
  <div class="page-shell">
    <header class="page-header">
      <div class="header-copy">
        <p class="eyebrow">Theoxenia / Mission control</p>
        <h1>Open search, with the evidence in view.</h1>
        {% if state.meta.demo %}
        <p class="subtitle">M0 prototype — rendered locally from synthetic run manifests.</p>
        {% else %}
        <p class="subtitle">Run-manifest-backed search status, with checks and provenance in view.</p>
        {% endif %}
      </div>
      <div class="status-pill status-pill--{{ status.tone }}" aria-label="Worker status: {{ status.label }}">
        <span class="status-dot{% if status.is_live %} status-dot--live{% endif %}" aria-hidden="true"></span>
        <span>{{ status.label }}</span>
      </div>
    </header>

    <main id="main">
      {% if state.meta.demo %}
      <div class="demo-banner" role="note">
        <strong>Demo data — every number here is a placeholder.</strong>
        <span>M0 only: no live worker or telescope observations are included.</span>
      </div>
      {% endif %}

      <section class="ticker-panel" aria-label="Search ticker">
        <p>{{ ticker }}</p>
        <span>State built {{ generated_at_text }}</span>
      </section>

      <section class="section-block" aria-labelledby="totals-heading">
        <div class="section-heading">
          <h2 id="totals-heading">What has been searched</h2>
          <p>Every count opens its supporting run manifests.</p>
        </div>
        <div class="metric-grid">
          {% for metric in metrics %}
          <a class="metric-card{% if metric.key == 'unexplained' %} metric-card--review{% endif %}" href="{{ metric.href }}">
            <span class="metric-label">{{ metric.label }}</span>
            <span class="metric-value">{{ metric.value }}</span>
            {% if metric.unit %}<span class="metric-unit">{{ metric.unit }}</span>{% endif %}
          </a>
          {% endfor %}
        </div>
      </section>

      <section class="section-block" aria-labelledby="hero-heading">
        <div class="section-heading">
          <h2 id="hero-heading">Voyager 1 known-answer run</h2>
          <p>The hero is populated only from the checked run manifest.</p>
        </div>
        {% if state.hero %}
        <article class="hero-card">
          <a class="hero-image-link" href="{{ hero_manifest_url }}" aria-label="Open the Voyager run manifest">
            <img src="{{ state.hero.image_url }}" alt="Voyager 1 waterfall from the run manifest" decoding="async">
          </a>
          <div class="hero-copy">
            <p class="eyebrow">{{ state.hero.experiment }} · {{ state.hero.run_id }}</p>
            <p>Frequency <strong>{{ "%.6f"|format(state.hero.freq_mhz) }} MHz</strong></p>
            <p>Drift <strong>{{ "%+.3f"|format(state.hero.drift_hz_s) }} Hz/s</strong></p>
            <p>SNR <strong>{{ "%.1f"|format(state.hero.snr) }}</strong></p>
            <a class="text-link" href="{{ hero_manifest_url }}">Open the run manifest</a>
          </div>
        </article>
        {% else %}
        <div class="empty-panel">
          <h3>Waiting for EXP-001</h3>
          {% if state.meta.demo %}
          <p>No Voyager result is available in this M0 demo.</p>
          {% else %}
          <p>No Voyager result is available yet.</p>
          {% endif %}
        </div>
        {% endif %}
      </section>

      <section class="section-block" aria-labelledby="map-heading">
        <div class="section-heading">
          <h2 id="map-heading">The sky we have searched</h2>
          <p>Equatorial view · the Galactic plane is shaded · each point links to its manifest.</p>
        </div>
        <div class="plot-card sky-card">
          <img class="sky-map" src="{{ sky_svg_url }}" alt="Mollweide sky map with Galactic plane band and manifest-linked pointings" decoding="async">
          <ul class="map-legend" aria-label="Sky map legend">
            <li><span class="legend-dot legend-dot--searched" aria-hidden="true"></span>Searched</li>
            <li><span class="legend-dot legend-dot--running" aria-hidden="true"></span>In progress</li>
            <li><span class="legend-dot legend-dot--survivor" aria-hidden="true"></span>Survivor</li>
            <li><span class="legend-dot legend-dot--failed" aria-hidden="true"></span>Failed pair</li>
          </ul>
          <ul class="visually-hidden" aria-label="Manifest links for searched pointings">
            {% for pointing in map_accessible_pointings %}
            <li><a href="{{ pointing.manifest_url }}">{{ pointing.target }} — {{ pointing.status.value }}, {{ pointing.hits }} hits</a></li>
            {% else %}
            <li>No pointings have been recorded.</li>
            {% endfor %}
          </ul>
        </div>
      </section>

      <section class="section-block" aria-labelledby="floor-heading">
        <div class="section-heading">
          <h2 id="floor-heading">Detection floor</h2>
          <p>Recovery results are computed from the injection grid; the summary is not hand-entered.</p>
        </div>
        <div class="floor-layout">
          <div class="plot-card floor-card">
            <img class="floor-map" src="{{ floor_svg_url }}" alt="Injection recovery floor heatmap" decoding="async">
          </div>
          <div class="floor-copy">
            {% if state.detection_floor %}
            <p class="eyebrow">{{ state.detection_floor.experiment }} · {{ state.detection_floor.run_id }}</p>
            <p>{{ state.detection_floor.summary }}</p>
            <p>Each cell records the fraction of injected signals recovered.</p>
            <a class="text-link" href="{{ floor_manifest_url }}">Open the injection run manifest</a>
            {% else %}
            <h3>Waiting for EXP-002</h3>
            {% if state.meta.demo %}
            <p>No recovery grid is available in this M0 demo.</p>
            {% else %}
            <p>No recovery grid is available yet.</p>
            {% endif %}
            {% endif %}
          </div>
        </div>
      </section>

      <section class="section-block" aria-labelledby="gallery-heading">
        <div class="section-heading">
          <h2 id="gallery-heading">Latest hits, and the checks applied.</h2>
          <p>Prosaic explanations are shown first; a manifest is one click away.</p>
        </div>
        {% if gallery %}
        <div class="gallery-grid">
          {% for item in gallery %}
          <article class="hit-card">
            <a class="hit-thumbnail" href="{{ item.manifest_url }}" aria-label="Open manifest for {{ item.target }}">
              <img src="{{ item.thumbnail_url }}" alt="Waterfall preview for {{ item.target }} at {{ "%.6f"|format(item.freq_mhz) }} MHz" loading="lazy" decoding="async">
            </a>
            <div class="hit-copy">
              <p class="verdict-badge verdict-badge--{{ item.verdict.value|lower }}">{{ item.badge_text }}</p>
              <h3>{{ item.target }}</h3>
              <p class="hit-metrics">{{ "%.6f"|format(item.freq_mhz) }} MHz · {{ "%+.3f"|format(item.drift_hz_s) }} Hz/s · SNR {{ "%.1f"|format(item.snr) }}</p>
              <p>{{ item.explanation }}</p>
              <a class="text-link" href="{{ item.manifest_url }}">Open run manifest</a>
            </div>
          </article>
          {% endfor %}
        </div>
        {% else %}
        <div class="empty-panel">
          <h3>No hits yet</h3>
          {% if state.meta.demo %}
          <p>There are no run manifests with hits in this demo state.</p>
          {% else %}
          <p>There are no cadence manifests with hit records yet.</p>
          {% endif %}
        </div>
        {% endif %}
      </section>

      <section class="section-block read-this" aria-labelledby="reading-heading">
        <h2 id="reading-heading">How to read this page</h2>
        <p>Counts are computed from run manifests. A “survivor” has passed the checks recorded so far; it is not a conclusion. “Unexplained” is reserved for a reviewed record with the required sign-offs. {% if state.meta.demo %}The M0 badge remains visible so demo values cannot be mistaken for observations.{% else %}Every displayed result links to its supporting run manifest.{% endif %}</p>
      </section>
    </main>

    <footer class="page-footer">
      <p>{{ state.meta.data_credit }}</p>
      <p><a href="{{ repo_url }}">Source code on GitHub</a></p>
      {% if mirror_url %}
      <p><a href="{{ mirror_url }}">GitHub Pages mirror</a> · static snapshot, not a live heartbeat</p>
      {% else %}
      <p>GitHub Pages mirror not yet deployed.</p>
      {% endif %}
      <p>State built {{ generated_at_text }} · Git {{ state.git_sha }} · Theoxenia {{ state.package_version }}</p>
    </footer>
  </div>
</body>
</html>
