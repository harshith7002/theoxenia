{
  "name": "Theoxenia · CPython 3.15",
  "build": {
    "dockerfile": "Dockerfile",
    "args": {
      "UV_VERSION": "0.13.0"
    }
  },
  "workspaceFolder": "/workspaces/theoxenia",
  "remoteUser": "vscode",
  "postCreateCommand": "uv python install 3.15.0 && uv sync --all-groups --python 3.15.0",
  "forwardPorts": [8080],
  "portsAttributes": {
    "8080": {
      "label": "Mission Control demo",
      "onAutoForward": "notify"
    }
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "charliermarsh.ruff"
      ],
      "settings": {
        "python.defaultInterpreterPath": "${workspaceFolder}/.venv/bin/python"
      }
    }
  }
}
