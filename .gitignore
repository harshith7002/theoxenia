!.env.example

# Never commit raw telescope or scan data.
data/
*.h5
*.hdf5
*.fil
*.fits
*.fits.gz

# Rendered page outputs are reproducible from source templates and manifests.
/site/index.html
/site/state.json
/site/sky.svg
/site/floor.svg
/site/runs/

# Keep manifests and named compact artifacts they reference; raw/generated data stays ignored.
/runs/state.json
/runs/**
!/runs/
!/runs/**/
!/runs/**/manifest.json
!/runs/**/failure.json
!/runs/**/slice_summary.json
!/runs/**/hits.json
!/runs/**/hero.png
!/runs/**/recovery_grid.json
!/runs/**/sweep.csv
!/runs/**/hits.parquet
!/runs/**/truth.json
!/runs/**/recovery.json
!/runs/**/thumbs/*.svg
!/runs/**/thumbs/*.png
!/runs/**/plots/*.png

